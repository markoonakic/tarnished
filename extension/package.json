{
  "name": "tarnished-extension",
  "version": "0.1.7",
  "description": "Browser extension for detecting and saving job listings to Tarnished",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:chrome": "vite build && cd dist && zip -r ../tarnished-chrome.zip .",
    "build:firefox": "vite build && cd dist && zip -r ../tarnished-firefox.zip .",
    "build:all": "yarn build:chrome && yarn build:firefox",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "@types/webextension-polyfill": "^0.12.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}

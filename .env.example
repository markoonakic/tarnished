# Copy next to your Docker Compose file as .env.
TARNISHED_IMAGE=ghcr.io/markoonakic/tarnished:0.3.8
APP_PORT=127.0.0.1:5577
APP_URL=http://localhost:5577

# Required only for the PostgreSQL Compose file.
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# Other backend settings need explicit Compose environment mappings.
# See documentation/content/reference/environment-variables.md.
